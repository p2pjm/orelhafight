{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!favicon\\.ico|favicon\\.png|robots\\.txt|sitemap\\.xml|assets/|static/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
